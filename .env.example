# OpenAI
OPENAI_API_KEY=

# Tavily (lead scout / scout skills)
TAVILY_API_KEY=

# Yahoo mail (sifter skill)
YAHOO_EMAIL=
YAHOO_PASSWORD=

# Second Yahoo account (optional)
YAHOO_EMAIL_2=
YAHOO_PASSWORD_2=

# Gmail (sifter skill, optional)
GMAIL_EMAIL=
GMAIL_PASSWORD=

# Weekly summary recipient
SUMMARY_TO=

# Enaam MCP server
ENAAM_MCP_URL=

# Hey Eman runtime
HEY_EMAN_USE_OPENAI=

# Password for the chief-of-staff desk (local and the private tunnel).
KHURSHEED_UI_PASSWORD=

# Priority inbox email alerts (sent when a priority >= 2 action is created)
# If any of TO/FROM/PASSWORD is missing, email is skipped (logged, never fatal).
KHURSHEED_PRIORITY_EMAIL_TO=
KHURSHEED_PRIORITY_EMAIL_FROM=
KHURSHEED_PRIORITY_EMAIL_PASSWORD=
KHURSHEED_PRIORITY_EMAIL_SMTP_HOST=smtp.gmail.com
KHURSHEED_PRIORITY_EMAIL_SMTP_PORT=587

# Blogger skill - LinkedIn publishing
# Kill switch: must be "true" (or "1") to allow mode=publish; otherwise posts are demoted to drafts.
KHURSHEED_BLOGGER_PUBLISH_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PAGE_ID=

# MCP servers (composition kernel) - tokens referenced by config/mcp_servers.json
BUSINESS_ASSESSMENT_API_KEY=
INSIGHT_VAULT_API_KEY=
CTO_DASHBOARD_API_KEY=

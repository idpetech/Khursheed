# Copy to .env for local use. On Railway, set these as service variables.
# Do not commit .env, the database, or any password.
#
# IMAP passwords are the variables named in config/email_accounts.json
# (YAHOO_PASSWORD, YAHOO_PASSWORD_2, GMAIL_PASSWORD). The addresses in that
# file are not secrets. App passwords stay in the host environment.
#
# Mount a Railway volume at /data. The image uses KHURSHEED_DB_PATH=/data/khursheed.db.
# Leave this empty on the Mac so the desk keeps using the project database.
# On Railway, also set TZ (the image defaults to America/New_York) so 07:00
# means your morning. Do not add a second cron service: the web process runs it.
KHURSHEED_DB_PATH=

# OpenAI
OPENAI_API_KEY=

# Tavily (lead scout / scout skills)
TAVILY_API_KEY=

# Yahoo mail (sifter skill)
YAHOO_EMAIL=
YAHOO_PASSWORD=

# Second Yahoo account (optional)
YAHOO_EMAIL_2=
YAHOO_PASSWORD_2=

# Gmail (sifter skill, optional)
GMAIL_EMAIL=
GMAIL_PASSWORD=

# Weekly summary recipient
SUMMARY_TO=

# Enaam MCP server
ENAAM_MCP_URL=

# Hey Eman runtime
HEY_EMAN_USE_OPENAI=

# Password for the chief-of-staff desk (local and the private tunnel).
KHURSHEED_UI_PASSWORD=

# Daily brief on Telegram. Create a bot with @BotFather, then message the bot
# once and read the chat id from https://api.telegram.org/bot<token>/getUpdates.
# If either value is missing, the brief is still written locally and the send is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Urgent WhatsApp alerts (priority 3 only: overdue, or due within 2 days).
# Sent as an approved utility template with two body variables: title, detail.
# If any value is missing, the send is skipped (logged, never fatal).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=enaam_urgent
WHATSAPP_TEMPLATE_LANG=en

# Priority inbox email. New priority actions no longer send this immediately.
# If any of TO/FROM/PASSWORD is missing, email is skipped (logged, never fatal).
KHURSHEED_PRIORITY_EMAIL_TO=
KHURSHEED_PRIORITY_EMAIL_FROM=
KHURSHEED_PRIORITY_EMAIL_PASSWORD=
KHURSHEED_PRIORITY_EMAIL_SMTP_HOST=smtp.gmail.com
KHURSHEED_PRIORITY_EMAIL_SMTP_PORT=587

# Blogger skill - LinkedIn publishing
# Kill switch: must be "true" (or "1") to allow mode=publish; otherwise posts are demoted to drafts.
KHURSHEED_BLOGGER_PUBLISH_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PAGE_ID=

# MCP servers (composition kernel) - tokens referenced by config/mcp_servers.json
BUSINESS_ASSESSMENT_API_KEY=
INSIGHT_VAULT_API_KEY=
CTO_DASHBOARD_API_KEY=
